---
// "Where does my data go?" Click an item to see where it lives and why.
const items = [
	{ id: 'audio', label: 'Meeting audio', where: 'mac', why: 'Transcribed on your Mac, then deleted. The last 20 short clips are kept for testing; you can turn that off.' },
	{ id: 'transcript', label: 'Transcripts', where: 'mac', why: 'Saved in your ozen folder. Nothing uploads them.' },
	{ id: 'fixes', label: 'Your text fixes', where: 'mac', why: 'Stay on your Mac, with the audio of each fixed line, for improving the transcriber.' },
	{ id: 'places', label: 'Home & work locations', where: 'mac', why: 'Saved only on this Mac. Your location is never sent anywhere.' },
	{ id: 'ignored', label: 'Ignored voices', where: 'mac', why: 'Kept on this Mac only, never shared with your other Macs.' },
	{ id: 'voices', label: 'Names & voiceprints', where: 'out', why: 'Shared with your other Macs through your own private voices repository, so they recognize the same people.' },
	{ id: 'ai', label: 'Meetings you give to AI', where: 'out', why: 'When you press Ask AI or Open, the AI assistant reads those transcripts, and a cloud assistant like Claude sends them to its provider.' },
	{ id: 'map', label: 'Map tiles', where: 'out', why: 'Only while the Places map is open, OpenStreetMap is asked for the map of that area. Not your location itself.' },
];
---

<div class="demo privacy not-content" data-privacy>
	<div class="zones">
		<section class="zone mac">
			<h4>🔒 Stays on your Mac</h4>
			<div class="chips">
				{items.filter((i) => i.where === 'mac').map((i) => <button data-why={i.why}>{i.label}</button>)}
			</div>
		</section>
		<section class="zone out">
			<h4>↗ Leaves your Mac, only as described</h4>
			<div class="chips">
				{items.filter((i) => i.where === 'out').map((i) => <button data-why={i.why}>{i.label}</button>)}
			</div>
		</section>
	</div>
	<p class="why" data-out aria-live="polite">Click any item to see where it goes.</p>
</div>

<style is:global>
	.privacy [hidden] { display: none !important; }
	.privacy .zones { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0.8rem; }
	@media (max-width: 40rem) { .privacy .zones { grid-template-columns: 1fr; } }
	.privacy .zone { border-radius: 12px; padding: 0.8rem; border: 1px solid var(--sl-color-gray-5); }
	.privacy .zone.mac { background: color-mix(in srgb, #3fc59b 10%, transparent); border-color: color-mix(in srgb, #3fc59b 45%, transparent); }
	.privacy .zone.out { background: color-mix(in srgb, var(--ozen-warn) 8%, transparent); border-color: color-mix(in srgb, var(--ozen-warn) 40%, transparent); }
	.privacy h4 { margin: 0 0 0.6rem; font-size: 0.9rem; }
	.privacy .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 !important; }
	.privacy .chips button {
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		margin: 0;
	}
	.privacy .chips button[aria-pressed='true'] { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
	.privacy .why { margin-top: 0.9rem !important; min-height: 3em; }
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-privacy]').forEach((root) => {
		const out = root.querySelector('[data-out]') as HTMLElement;
		root.querySelectorAll<HTMLButtonElement>('button[data-why]').forEach((b) => {
			b.setAttribute('aria-pressed', 'false');
			b.addEventListener('click', () => {
				root.querySelectorAll('button[data-why]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				out.textContent = `${b.textContent}: ${b.dataset.why}`;
			});
		});
	});
</script>
