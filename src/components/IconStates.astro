---
// The four looks of ozen's menu bar icon.
const ear = 'M9 13a7.5 7.5 0 0 1 15 0c0 4.2-3.2 5.2-4.2 8.4C18.9 24.6 17.6 27 14.6 27A4.2 4.2 0 0 1 10.5 24M13.4 13a3.1 3.1 0 0 1 6.2 0c0 2.1-2.3 2.6-2.3 4.8';
const states = [
	{ name: 'Recording', note: 'Red, filled ear', path: ear, rec: true },
	{ name: 'Stopped', note: 'Plain ear', path: ear },
	{ name: 'Paused', note: 'Pause symbol', path: 'M12 9v14M20 9v14' },
	{ name: 'Finishing up', note: 'Hourglass: transcribing what it already heard', path: 'M10 7h12M10 25h12M11 7c0 6 10 6 10 12s-10 0-10 6M21 7c0 6-10 6-10 12' },
];
---

<div class="icons">
	{states.map((s) => (
		<figure>
			<svg viewBox="0 0 32 32" fill={s.rec ? 'color-mix(in srgb, var(--ozen-rec) 25%, transparent)' : 'none'} stroke={s.rec ? 'var(--ozen-rec)' : 'currentColor'} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.path} /></svg>
			<figcaption><b>{s.name}</b><span>{s.note}</span></figcaption>
		</figure>
	))}
</div>

<style>
	.icons { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.6rem; margin-block: 1.2rem; }
	figure { margin: 0; display: flex; gap: 0.7rem; align-items: center; padding: 0.7rem; border: 1px solid var(--sl-color-gray-5); border-radius: 12px; }
	svg { width: 2rem; height: 2rem; flex: none; }
	figcaption { display: grid; font-size: 0.8rem; color: var(--sl-color-gray-3); line-height: 1.3; }
	figcaption b { color: var(--sl-color-white); font-size: 0.9rem; }
</style>
